# MindIsle (009) 环境变量模板 —— 复制为 .env 后填写；.env 已被 .gitignore 排除
# 生成 JWT_SECRET： powershell -c "[Convert]::ToBase64String((1..48|ForEach-Object{Get-Random -Max 256}))"
DEEPSEEK_API_KEY=sk-替换成你自己的
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以 /models 实测为准（deepseek-chat 属历史命名已弃用；见需求 §11.1 第8条 / 手册 §2.1 任务0.10）
DEEPSEEK_MODEL=deepseek-flash
DB_URL=jdbc:mysql://127.0.0.1:3306/mindisle?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=mindisle
DB_PASSWORD=你在 init-db.ps1 里设置的口令
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MINDISLE_CACHE_MODE=redis
JWT_SECRET=至少32字节随机串
ADMIN_INIT_PASSWORD=首次登录后立即改
ANON_RETENTION_DAYS=90
CRISIS_HOTLINE=12356